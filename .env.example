# ==============================================================================
# Bodycam Vanguard — Optional Static Frontend Environment Variables
# ==============================================================================
# This app is a 100% static frontend and works out-of-the-box with NO env vars.
# SECURITY: Never place API keys, TURN tokens, or secrets in VITE_* variables
# because Vite embeds VITE_* values into the public client bundle.
# ==============================================================================

# Optional Cloudflare TURN Worker URL (for stable WebRTC/PeerJS over VPN/NAT)
# Deploy /worker first, then set this to your Worker URL (no secret needed here):
# VITE_TURN_WORKER_URL="https://bodycam-vanguard-turn.your-subdomain.workers.dev"

# Optional custom PeerJS signaling server (highest priority if set)
# VITE_PEER_HOST="peer.your-domain.com"
# VITE_PEER_PORT="443"
# VITE_PEER_PATH="/peerjs"
# VITE_PEER_SECURE="true"

# Optional comma-separated backup PeerJS brokers (host:port/path or https://host:port/path)
# VITE_PEER_BACKUP_BROKERS="0.peerjs.com:443/"

# ==============================================================================
# Server-Side Only (Netlify Environment Variables — NEVER prefix with VITE_)
# ==============================================================================
# Secret redeem codes verified exclusively inside netlify/functions/redeem.mjs.
# Set these values in Netlify Dashboard -> Site configuration -> Environment variables.
REDEEM_CODE_LEGENDARY_AK47=
REDEEM_CODE_LEGENDARY_SNIPER=
REDEEM_CODE_MYTHIC_M249=
